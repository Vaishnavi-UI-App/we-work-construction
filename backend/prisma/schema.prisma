generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---- GST Tax Invoice / Billing ----
model Bill {
  id            Int        @id @default(autoincrement())
  invoiceNumber String     @unique
  date          DateTime   @default(now())

  // Bill To / Receiver (customer)
  billToName    String
  billToAddress String?
  billToGst     String?
  billToMobile  String?
  billToEmail   String?
  billToState   String?

  // Ship To / Consignee — defaults to same as billing when left blank
  shipToName    String?
  shipToAddress String?
  shipToGst     String?
  shipToState   String?

  // Order / project references
  poNumber      String?
  poDate        String?
  vendorCode    String?
  projectCode   String?
  projectName   String?

  // Dispatch / transport details
  dateOfSupply     DateTime?
  placeOfSupply    String?
  reverseCharge    String?  @default("NO")
  vehicleNumber    String?
  transportMode    String?
  siteName         String?
  deliveredThrough String?

  // Tax
  gstRate       Float      @default(9)   // per-half rate: 9 => CGST 9% + SGST 9%
  subtotal      Float      @default(0)
  cgst          Float      @default(0)
  sgst          Float      @default(0)
  total         Float      @default(0)
  amountInWords String?

  createdAt     DateTime   @default(now())
  items         BillItem[]
}

model BillItem {
  id          Int    @id @default(autoincrement())
  billId      Int
  bill        Bill   @relation(fields: [billId], references: [id], onDelete: Cascade)
  lineNo      Int    @default(0)
  description String
  hsnCode     String?
  unit        String @default("EA")
  quantity    Float  @default(0)
  unitPrice   Float  @default(0)
  amount      Float  @default(0)
}

// Delivery Challan — accompanies goods in transit without billing them (no GST/pricing).
model DeliveryChallan {
  id             Int                   @id @default(autoincrement())
  challanNumber  String                @unique
  date           DateTime              @default(now())

  billToName     String
  billToAddress  String?
  billToGst      String?
  billToMobile   String?
  billToEmail    String?
  billToState    String?

  shipToName     String?
  shipToAddress  String?
  shipToGst      String?
  shipToState    String?

  poNumber       String?
  poDate         String?
  purpose        String?  @default("Delivery")
  dateOfSupply   DateTime?
  placeOfSupply  String?
  vehicleNumber  String?
  transportMode  String?
  siteName       String?
  deliveredThrough String?

  createdAt      DateTime              @default(now())
  items          DeliveryChallanItem[]
}

model DeliveryChallanItem {
  id          Int             @id @default(autoincrement())
  challanId   Int
  challan     DeliveryChallan @relation(fields: [challanId], references: [id], onDelete: Cascade)
  lineNo      Int             @default(0)
  description String
  hsnCode     String?
  unit        String          @default("EA")
  quantity    Float           @default(0)
}

// Remembered product -> HSN/SAC mapping for quick reuse. Each HSN/SAC code
// may only ever map to a single product description.
model HsnCode {
  id          Int      @id @default(autoincrement())
  description String   @unique
  code        String   @unique
  unit        String?
  unitPrice   Float?
  updatedAt   DateTime @updatedAt
}

// One-time token emailed to a user for self-service password reset.
model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
}

model User {
  id              Int              @id @default(autoincrement())
  email           String           @unique
  name            String?
  password        String
  role            String           @default("EMPLOYEE")
  roleId          Int?
  roleRef         Role?            @relation(fields: [roleId], references: [id])
  siteId          Int?
  site            Site?            @relation(fields: [siteId], references: [id])
  resetTokens     PasswordResetToken[]
  phone           String?
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  audits          Audit[]
  managedExpenses Expense[]        @relation("ManagerExpenses")
  fundAllocations FundAllocation[]
  attendances     Attendance[]
}

// Banking / customer ledger — a payment received from (or advance paid by) a
// customer. customerName is freeform text, matching Bill.billToName, so a
// payment doesn't require the customer to already exist as a Bill or Customer record.
model Payment {
  id           Int      @id @default(autoincrement())
  customerName String
  amount       Float
  date         DateTime @default(now())
  method       String?
  reference    String?
  notes        String?
  createdAt    DateTime @default(now())
}

// Admin-defined custom role — everything except the fixed ADMIN super-role
model Role {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  isAllSites  Boolean          @default(false) // members see every branch's data instead of just their assigned site
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  users       User[]
}

// Per-module view/add/edit/delete access for a Role
model RolePermission {
  id        Int     @id @default(autoincrement())
  roleId    Int
  role      Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  module    String
  canView   Boolean @default(false)
  canAdd    Boolean @default(false)
  canEdit   Boolean @default(false)
  canDelete Boolean @default(false)

  @@unique([roleId, module])
}

model Invoice {
  id            Int           @id @default(autoincrement())
  invoiceNumber String        @unique
  date          DateTime      @default(now())
  dueDate       DateTime?
  siteId        Int
  site          Site          @relation(fields: [siteId], references: [id])
  customerId    Int?
  customer      Customer?     @relation("CustomerInvoices", fields: [customerId], references: [id])
  customerName  String?
  subtotal      Float?
  tax           Float?
  total         Float?
  items         InvoiceItem[]
}

model Audit {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  action    String
  invoiceId Int?
  createdAt DateTime @default(now())
}

model Customer {
  id        Int       @id @default(autoincrement())
  name      String
  phone     String?
  address   String?
  createdAt DateTime  @default(now())
  invoices  Invoice[] @relation("CustomerInvoices")
}

model Vendor {
  id         Int      @id @default(autoincrement())
  name       String
  agencyCode String?
  phone      String?
  address    String?
  createdAt  DateTime @default(now())
}

model Expense {
  id           Int      @id @default(autoincrement())
  siteId       Int
  site         Site     @relation(fields: [siteId], references: [id])
  managerId    Int?
  manager      User?    @relation("ManagerExpenses", fields: [managerId], references: [id])
  category     String
  amount       Float
  companyPaid  Float    @default(0)
  personalPaid Float    @default(0)
  fundType     String   @default("COMPANY")
  receiptUrl   String?
  date         DateTime @default(now())
  notes        String?
  orderedBy    String?
  approved     Boolean  @default(false)
}

// Master list of people who can be selected as "Ordered By" on an expense
model OrderedByPerson {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
}

// User-created expense categories (replaces the old fixed category list)
model ExpenseCategory {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  createdAt DateTime @default(now())
}

model SiteWallet {
  id                      Int      @id @default(autoincrement())
  siteId                  Int      @unique
  site                    Site     @relation(fields: [siteId], references: [id])
  companyBalance          Float    @default(0)
  totalCompanySpent       Float    @default(0)
  totalPersonalSpent      Float    @default(0)
  totalPersonalReimbursed Float    @default(0)
  totalFundsReceived      Float    @default(0)
  updatedAt               DateTime @updatedAt
}

model FundAllocation {
  id               Int      @id @default(autoincrement())
  siteId           Int
  site             Site     @relation(fields: [siteId], references: [id])
  addedById        Int?
  addedBy          User?    @relation(fields: [addedById], references: [id])
  amount           Float
  reimbursedAmount Float    @default(0)
  notes            String?
  date             DateTime @default(now())
}

model Attendance {
  id           Int       @id @default(autoincrement())
  userId       Int
  user         User      @relation(fields: [userId], references: [id])
  date         String
  checkIn      DateTime?
  checkOut     DateTime?
  checkInLat   Float?
  checkInLng   Float?
  checkOutLat  Float?
  checkOutLng  Float?
  hoursWorked  Float?
  notes        String?
  createdAt    DateTime  @default(now())

  @@unique([userId, date])
}

model Project {
  id        Int      @id @default(autoincrement())
  name      String
  siteId    Int?
  site      Site?    @relation(fields: [siteId], references: [id])
  createdAt DateTime @default(now())
}

model Site {
  id              Int              @id @default(autoincrement())
  name            String           @unique
  invoices        Invoice[]
  expenses        Expense[]
  projects        Project[]
  wallet          SiteWallet?
  fundAllocations FundAllocation[]
  users           User[]
}

model InvoiceItem {
  id          Int     @id @default(autoincrement())
  invoiceId   Int
  invoice     Invoice @relation(fields: [invoiceId], references: [id])
  description String
  quantity    Int
  unitPrice   Float
  total       Float
}

model Organisation {
  id          Int      @id @default(autoincrement())
  companyName String?
  tagline     String?
  regNumber   String?
  gstNumber   String?
  panNumber   String?
  address     String?
  city        String?
  state       String?
  pincode     String?
  phone       String?
  email       String?
  website     String?
  updatedAt   DateTime @updatedAt
}

model OrgDocument {
  id         Int      @id @default(autoincrement())
  name       String
  docType    String
  fileUrl    String
  uploadedAt DateTime @default(now())
}
