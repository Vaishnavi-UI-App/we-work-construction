DATABASE_URL="file:./dev.db"
JWT_SECRET="replace-with-strong-secret"

# Optional — enables real password-reset emails via Gmail SMTP.
# EMAIL_PASS is a Google "App Password" (Account > Security > App Passwords),
# not the normal account password. Leave both unset to fall back to showing
# the reset link directly on the login page instead of emailing it.
EMAIL_USER=""
EMAIL_PASS=""
